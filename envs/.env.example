# .env.development
# .env.development.mobile
# .env.local
# .env.local.mobile
# .env.production
# .env.production.mobile

# Client-side variables must have the VITE_ prefix

# VITE_API_URL=https://api.dev.example.com/
# VITE_APP_NAME=Boilerplate Frontend TanStack Router

# Platform switch: web (default) or mobile
# Required in .mobile env files — without it mobile builds silently produce a web bundle
# VITE_PLATFORM=web
# VITE_PLATFORM=mobile

# Dev server mock and proxy
# VITE_DEV_SERVER_USE_MOCK=true
# VITE_DEV_SERVER_LOG_PROXY=true
# VITE_API_BASE_URL_ORIGINAL=https://api.dev.example.com/
