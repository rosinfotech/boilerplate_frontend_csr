{
    "name": "boilerplate-frontend-tanstack-router",
    "private": true,
    "version": "0.1.1",
    "type": "module",
    "scripts": {
        "build": "dotenv -e envs/.env.production -e envs/.env.local -- vite build --mode production",
        "build:dev": "dotenv -e envs/.env.development -e envs/.env.local -- vite build --mode development",
        "build:mobile": "dotenv -e envs/.env.production.mobile -e envs/.env.local.mobile -- vite build --mode production && npm run mobile:prepare-webdir && npm run mobile:assets",
        "build:mobile:android": "npm run build:mobile && npx cap sync android && npx cap open android",
        "build:mobile:ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
        "dev": "dotenv -e envs/.env.development -e envs/.env.local -- vite dev --mode development",
        "dev:mobile": "dotenv -e envs/.env.development.mobile -e envs/.env.local.mobile -- vite dev --mode development",
        "dev:mobile:android": "dotenv -e envs/.env.development.mobile -e envs/.env.local.mobile -- npx cap sync android && npx cap open android",
        "dev:mobile:ios": "dotenv -e envs/.env.development.mobile -e envs/.env.local.mobile -- npx cap sync ios && npx cap open ios",
        "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss}\"",
        "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss}\"",
        "husky:pre-commit": "",
        "husky:pre-push": "npm run format:fix && npm run stylelint:fix && npm run lint:fix",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "mobile:assets": "capacitor-assets generate --assetPath src/capacitor/assets --iconBackgroundColor 'transparent' --iconBackgroundColorDark 'transparent' --ios --android",
        "mobile:init": "npx cap add ios && npx cap add android",
        "mobile:prepare-webdir": "node .scripts/prepare-mobile-webdir.ts",
        "prepare": "husky",
        "start": "node .build/web/server/index.mjs",
        "stylelint": "stylelint \"**/*.{css,scss}\"",
        "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
        "test": "vitest --run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@tanstack/react-router": "^1.170.32",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/react-start": "^1.168.49",
        "antd": "^6.1.1",
        "clsx": "^2.1.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.1.17",
        "zod": "^4.4.3",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@capacitor-community/safe-area": "^8.0.1",
        "@capacitor/android": "^8.0.0",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.0.0",
        "@capacitor/core": "^8.0.0",
        "@capacitor/ios": "^8.0.0",
        "@capacitor/local-notifications": "^8.0.0",
        "@eslint/js": "^10.0.1",
        "@rosinfo.tech/eslint-config-import": "^0.0.9",
        "@rosinfo.tech/eslint-config-javascript": "^0.0.32",
        "@rosinfo.tech/eslint-config-react": "^0.0.20",
        "@rosinfo.tech/eslint-config-typescript": "^0.1.0",
        "@rosinfo.tech/prettier-config-standard": "^0.0.12",
        "@rosinfo.tech/stylelint-config-standard": "^0.1.0",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/router-plugin": "^1.168.35",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.17.1",
        "git-describe": "^4.1.1",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "nitro": "^3.0.260610-beta",
        "prettier": "^3.7.4",
        "stylelint": "^17.14.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.6",
        "vite-plugin-circular-dependency": "^0.5.0",
        "vite-plugin-magical-svg": "^1.8.0",
        "vite-plugin-mock-dev-server": "^2.0.6",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=22.22.1",
        "npm": ">=9.0.0"
    },
    "overrides": {
        "@capacitor/assets": {
            "@capacitor/cli": "^8.5.0"
        },
        "sharp": "^0.35.3"
    }
}
